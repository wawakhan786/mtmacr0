  <!--
    =======================================================================
    SELECAO DO PLATFORM TOOLSET — em UM lugar so'.
    =======================================================================

    O QUE ESTAVA ERRADO (bug real, custou um build quebrado):

        <PlatformToolset Condition="... !Exists('...\v143\Microsoft.Cpp.$(Platform).v143.props')">v145</PlatformToolset>

    Esse arquivo NAO EXISTE no VS 2022 atual. A pasta do toolset
    (`...\PlatformToolsets\v143\`) tem, desde o 17.14:

        Toolset.props
        Toolset.targets

    e nao mais `Microsoft.Cpp.x64.v143.props`. O `Exists()` dava falso
    SEMPRE, o projeto caia para o v145 (VS 2026) e o build morria com
    MSB8020 — mesmo com o v143 instalado e funcionando. O sintoma mentia:
    parecia toolset ausente, era nome de arquivo velho.

    A correcao tem dois cuidados:

      1. testa as DUAS grafias (`Toolset.props` e a antiga), porque a
         maquina pode ter VS 17.0-17.13 ou 17.14+;
      2. TODAS as condicoes exigem `'$(PlatformToolset)'==''`, entao um
         `-p:PlatformToolset=...` na linha de comando continua ganhando.
         A ordem importa: cada linha so' age se as anteriores nao agiram.

    O fallback final e' v143 sem condicao. Se nenhum dos dois existir, o
    MSB8020 aparece com a mensagem certa ("instale o v143"), em vez de
    pedir o v145 do nada.
    =======================================================================
  -->
  <PropertyGroup Label="ToolsetSelection">
    <VcToolsetsDir>$(VCTargetsPath)\Platforms\$(Platform)\PlatformToolsets</VcToolsetsDir>
    <PlatformToolset Condition="'$(PlatformToolset)'=='' and Exists('$(VcToolsetsDir)\v143\Toolset.props')">v143</PlatformToolset>
    <PlatformToolset Condition="'$(PlatformToolset)'=='' and Exists('$(VcToolsetsDir)\v143\Microsoft.Cpp.$(Platform).v143.props')">v143</PlatformToolset>
    <PlatformToolset Condition="'$(PlatformToolset)'=='' and Exists('$(VcToolsetsDir)\v145\Toolset.props')">v145</PlatformToolset>
    <PlatformToolset Condition="'$(PlatformToolset)'=='' and Exists('$(VcToolsetsDir)\v145\Microsoft.Cpp.$(Platform).v145.props')">v145</PlatformToolset>
    <PlatformToolset Condition="'$(PlatformToolset)'==''">v143</PlatformToolset>
  </PropertyGroup>
